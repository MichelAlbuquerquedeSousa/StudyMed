# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard → Project Settings → API Keys). A chave "publishable" é pública por design;
# a proteção dos dados vem das políticas de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
